# ============================================================================
# AI Digital Employee v2.0 — Runtime Configuration (.env.example)
# ============================================================================

# 1. Inference Data-Flow Mode: "cloud_api" (mandatory DLP redaction) | "intranet_only"
DE_INFERENCE_MODE=cloud_api

# 2. OpenAI-Compatible LLM Endpoint (DeepSeek / OpenAI / Local vLLM / Qwen)
DE_LLM_BASE_URL=https://api.deepseek.com
DE_LLM_API_KEY=
DE_FAST_MODEL=deepseek-flash
DE_REASONING_MODEL=deepseek-v4-pro
DE_LLM_TIMEOUT_SECONDS=60

# 2b. Independent Cross-Model PR Review Agent (Claude / OpenAI / OpenRouter / Gemini)
# Uses `skills/pr-code-review/SKILL.md` to post concise blocking-only PR reviews.
DE_REVIEWER_PROVIDER=openai_compatible
DE_REVIEWER_BASE_URL=
DE_REVIEWER_API_KEY=
DE_REVIEWER_MODEL=

# Optional local fallback .env file to inherit LLM keys in dev mode (leave empty in prod)
DE_FALLBACK_ENV_FILE=

# 3. Runtime Storage & Isolated Worktree Root (mount as volume `/data` in Docker)
DE_DATA_DIR=.local
DE_REPO_REGISTRY=configs/repositories.yaml

# 4. Default Task Guardrails
DE_DEFAULT_TENANT_ID=default
DE_DEFAULT_WORKSPACE_ID=default-workspace
DE_DEFAULT_OWNER_ID=developer
DE_DEFAULT_MAX_BUDGET_USD=1.50
DE_MAX_CODING_STEPS=32
DE_MAX_SELF_HEAL_ATTEMPTS=3
# Coding Runtime Engine: "kernel" (default white-box mewcode agent kernel) | "external_cli"
DE_CODING_RUNTIME=kernel
DE_EXTERNAL_CODING_CLI=claude
DE_ENABLE_OS_SANDBOX=false
DE_ENABLE_OPS_MCP=true
# Persistent Repository Memory (`claude-mem` dual-mode: built-in SQLite FTS5 by default, or external worker URL e.g. http://127.0.0.1:37777)
DE_ENABLE_CLAUDE_MEM=true
DE_CLAUDE_MEM_URL=

# 5. GitHub Integration (Draft PR, Auto-Onboarding & Review Comment Poller)
# Fine-grained PAT permissions: Contents (Read & write), Pull requests (Read & write), Actions (Read-only)
DE_GITHUB_TOKEN=
DE_GITHUB_API_BASE=https://api.github.com

# 6. Feishu Integration (Webhook Card Bot OR Zero-Public-IP WebSocket App)
DE_FEISHU_WEBHOOK_URL=
DE_FEISHU_APP_ID=
DE_FEISHU_APP_SECRET=
DE_FEISHU_VERIFICATION_TOKEN=

# 7. Jira Integration (Authoritative Work-Order Source of Truth)
DE_JIRA_BASE_URL=
DE_JIRA_EMAIL=
DE_JIRA_API_TOKEN=
DE_JIRA_DEFAULT_PROJECT=
DE_JIRA_POLL_JQL=labels = "ai-delegate" AND statusCategory = "To Do"
DE_JIRA_POLLER_ENABLED=true

# 8. Web Control Plane
DE_WEB_HOST=127.0.0.1
DE_WEB_PORT=8020
# Optional external URL (e.g. Cloudflare Tunnel / Tailscale Funnel) for external PR/Jira report links
DE_PUBLIC_WEB_URL=
