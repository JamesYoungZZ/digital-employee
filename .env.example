# ============================================================================
# AI Digital Employee V1 — Runtime Configuration (.env.example)
# ============================================================================

# 1. Inference Data-Flow Mode: "cloud_api" (mandatory DLP redaction) | "intranet_only"
DE_INFERENCE_MODE=cloud_api

# 2. OpenAI-Compatible LLM Endpoint (DeepSeek / OpenAI / Local vLLM / Qwen)
DE_LLM_BASE_URL=https://api.deepseek.com
DE_LLM_API_KEY=
DE_FAST_MODEL=deepseek-flash
DE_REASONING_MODEL=deepseek-v4-pro
DE_LLM_TIMEOUT_SECONDS=60

# Optional local fallback .env file to inherit LLM keys in personal dev mode (leave empty in team/prod)
DE_FALLBACK_ENV_FILE=/Users/jamesyang/Documents/chat-assistant/livestream-copilot/.env

# 3. Runtime Storage & Isolated Worktree Root
DE_DATA_DIR=/Users/jamesyang/Documents/digital-employee/.local
DE_REPO_REGISTRY=/Users/jamesyang/Documents/digital-employee/configs/repositories.yaml

# 4. Default Task Guardrails
DE_DEFAULT_TENANT_ID=personal
DE_DEFAULT_WORKSPACE_ID=jamesyang-mac
DE_DEFAULT_OWNER_ID=jamesyang
DE_DEFAULT_MAX_BUDGET_USD=1.50
DE_MAX_CODING_STEPS=18
DE_MAX_SELF_HEAL_ATTEMPTS=3

# 5. GitHub Integration (Draft PR & Review Comment Follow-Through)
DE_GITHUB_TOKEN=
DE_GITHUB_API_BASE=https://api.github.com

# 6. Feishu Integration (Webhook / Interactive Card Bot)
DE_FEISHU_WEBHOOK_URL=
DE_FEISHU_APP_ID=
DE_FEISHU_APP_SECRET=
DE_FEISHU_VERIFICATION_TOKEN=

# 7. Web Control Plane
DE_WEB_HOST=127.0.0.1
DE_WEB_PORT=8020
